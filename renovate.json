{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "semanticCommits": "enabled",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "pyenv": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Group Nix flake input updates into a single PR",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs"
    },
    {
      "description": "Group non-major CI action updates in .forgejo/workflows; major bumps get their own PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "groupName": "CI workflow actions",
      "groupSlug": "ci-workflow-actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Python version in .python-version, preserving any uv flavour suffix such as +gil or +freethreaded",
      "managerFilePatterns": ["/(^|/)\\.python-version$/"],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)(?<suffix>\\+[A-Za-z0-9._-]+)?\\s*$"
      ],
      "autoReplaceStringTemplate": "{{{newValue}}}{{{suffix}}}",
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "versioningTemplate": "python"
    }
  ]
}
